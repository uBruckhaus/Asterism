#!/bin/sh
# Asterism AppImage: the system's Python with PyGObject, GTK 4 and libadwaita runs the bundled app.
# Asterism is the app outside Omarchy; on Omarchy the AI Agents Map plugin is the integrated
# version (same code, its own name, settings and window id).
: "${ASTERISM_DESKTOP:=generic}"
export ASTERISM_DESKTOP
here=$(dirname "$(readlink -f "$0")")
if ! /usr/bin/python3 -c 'import gi; gi.require_version("Gtk", "4.0"); gi.require_version("Adw", "1")' 2>/dev/null; then
    echo "Asterism needs Python 3 with PyGObject, GTK 4 and libadwaita from your distribution:" >&2
    echo "  Fedora: sudo dnf install python3-gobject gtk4 libadwaita" >&2
    echo "  Ubuntu/Debian: sudo apt install python3-gi gir1.2-gtk-4.0 gir1.2-adw-1" >&2
    echo "  Arch: sudo pacman -S python-gobject gtk4 libadwaita" >&2
    exit 1
fi
exec /usr/bin/python3 "$here/usr/lib/asterism/ai_popup.py" "$@"
