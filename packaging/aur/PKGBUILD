# Maintainer: Uwe Bruckhaus
pkgname=asterism
pkgver=0.11.1
pkgrel=1
pkgdesc="Your AI agents, models and tools on one map (GTK4/libadwaita)"
arch=('any')
url="https://github.com/uBruckhaus/Asterism"
license=('MIT')
depends=('python' 'python-gobject' 'gtk4' 'libadwaita' 'curl' 'openssh' 'ttf-nerd-fonts-symbols')
optdepends=('vte4: agents in a terminal inside the window'
            'xdg-terminal-exec: start agents in your own terminal'
            'mise: updates for agents installed with mise')
# The signed agent and provider add-ons (switched off until the first start's Set up).
_addons=https://github.com/uBruckhaus/asterism-addons/releases/download
_adapters=0.11.0              # the adapter add-ons' own release (signed separately)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "adapters-$_adapters.zip::$_addons/adapters-$_adapters/adapters-$_adapters.zip")
noextract=("adapters-$_adapters.zip")
sha256sums=('4e2d16d8ea8f8242bbc5de0b2a00e35801c2e5f42b514ba817132295fed659d6'
            '1cc38cc14bb3fe51eb75cc1d3e874c53e0cc68cc068e11fb7e167cf3bf380355')

package() {
    cd "Asterism-$pkgver"          # GitHub names the folder after the repository
    install -d "$pkgdir/usr/lib/asterism"
    install -m644 ./*.py "$pkgdir/usr/lib/asterism/"
    install -Dm644 translations/*.json -t "$pkgdir/usr/lib/asterism/translations/"
    cp -r icons "$pkgdir/usr/lib/asterism/icons"
    install -Dm644 adapters/*.toml adapters/*.py -t "$pkgdir/usr/lib/asterism/adapters/"   # built-in agents as data
    install -Dm644 data/user-manual*.pdf -t "$pkgdir/usr/lib/asterism/data/"
    python packaging/unpack-adapters.py "$srcdir/adapters-$_adapters.zip" "$pkgdir/usr/lib/asterism/addons"
    install -Dm755 bin/asterism "$pkgdir/usr/bin/asterism"
    install -Dm644 data/io.github.ubruckhaus.Asterism.desktop -t "$pkgdir/usr/share/applications/"
    install -Dm644 data/io.github.ubruckhaus.Asterism.metainfo.xml -t "$pkgdir/usr/share/metainfo/"
    install -Dm644 data/icons/io.github.ubruckhaus.Asterism.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
    install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
